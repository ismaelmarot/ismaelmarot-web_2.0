# Copy to .env.local and fill in with a real key from https://web3forms.com
# The form renders its "not configured" message without one and never attempts to send.
VITE_WEB3FORMS_ACCESS_KEY=

# This value is not a secret. Web3Forms documents the access key as a public alias for the
# destination address, and it is inlined into the deployed JavaScript either way. It lives in
# an environment variable so it can be rotated without a code change.
